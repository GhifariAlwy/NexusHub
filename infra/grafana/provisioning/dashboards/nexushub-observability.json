      "id": 3,
      "title": "P95 Processing Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) as time, quantile(0.95)(processing_latency_ms) as p95_latency FROM observability_db.audit_logs GROUP BY time ORDER BY time",
          "refId": "A"
        }
