      },
      "title": "Traffic per Tenant (Last 1 Hour)",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) as time, source_tenant, count() as total_messages FROM observability_db.audit_logs GROUP BY time, source_tenant ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "title": "P95 Processing Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) as time, quantile(0.95)(processing_latency_ms) as p95_latency FROM observability_db.audit_logs GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
