      "title": "Traffic per Tenant (Last 1 Hour)",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) as time, source_tenant, count() as total_messages FROM observability_db.audit_logs GROUP BY time, source_tenant ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
